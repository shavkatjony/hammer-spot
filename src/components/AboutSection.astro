---
import SectionHead from './SectionHead.astro';
import { identity, education, experience, languages, targetRoles, interests, projects, resume } from '../content/site';
import { url } from '../lib/url';
const edu = education[0];
const job = experience[0];
const [years, delivered] = identity.credentials;
---
<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap wrap--wide">
    <SectionHead no="04" title="About" id="about-title" />
    <div class="about__grid">
      <div class="about__prose prose" data-reveal="fade">
        <p class="about__lead">
          I’m {identity.name}, a data scientist in Busan focused on machine learning, statistical modelling and applied
          AI. I studied Integrated Business Management at Dong-A University, where statistics and econometrics pulled me
          toward data.
        </p>
        <p>
          I have {years.value} {years.long} and {delivered.value} {delivered.long}, including my work as a data and business
          analyst at {job.org}. I take a problem from data preparation and analysis through modelling, evaluation and
          delivery: reproducible pipelines, data-quality checks, models chosen against baselines, and evaluation on data
          the model never saw. My flagship project, DPEC, forecasts Formula 1 race pace from public timing data; its README
          traces every number to its source.
        </p>
        <p>
          I’d rather show than tell: the code, the tests, the write-ups and the limits of each project, stated plainly.
        </p>
      </div>

      <div class="about__record">
        <h3 class="about__h mono caps">Record</h3>
        <ol class="record" role="list">
          <li class="record__item">
            <p class="record__meta"><span class="record__type">Employment</span><span>{job.period}</span></p>
            <p class="record__title">{job.role}, {job.org}</p>
            <p class="record__sub">{job.place}</p>
            <ul class="record__points">
              {job.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </li>
          <li class="record__item">
            <p class="record__meta"><span class="record__type">Education</span><span>{edu.year}</span></p>
            <p class="record__title">{edu.degree}</p>
            <p class="record__sub">{edu.school}, {edu.place} · {edu.focus}</p>
          </li>
          <li class="record__item">
            <p class="record__meta"><span class="record__type">Independent projects</span><span>2026</span></p>
            <p class="record__title">Five projects with case studies</p>
            <p class="record__links">
              {projects.map((p) => (
                <a href={url(`work/${p.slug}/`)}><span class="mono">{p.index}</span> {p.short}</a>
              ))}
            </p>
          </li>
          <li class="record__item">
            <p class="record__meta"><span class="record__type">Academic project</span><span>2023</span></p>
            <p class="record__title">Lotte World Busan visitor review mining</p>
            <p class="record__sub">Dong-A University team project · KH Coder, descriptive statistics</p>
          </li>
        </ol>
      </div>
    </div>

    <div class="about__facts">
      <section class="fact" aria-labelledby="f-roles">
        <h3 id="f-roles" class="about__h mono caps">Looking for</h3>
        <ul class="fact__list">
          {targetRoles.map((r) => <li>{r}</li>)}
        </ul>
        <p class="fact__note">Open to {identity.availability.scope}.</p>
        <a class="link-arrow" href={resume.pdf ? url(resume.pdf) : url(resume.page)}>Download the CV (PDF) →</a>
      </section>
      <section class="fact" aria-labelledby="f-int">
        <h3 id="f-int" class="about__h mono caps">Professional interests</h3>
        <ul class="fact__list">
          {interests.map((r) => <li>{r}</li>)}
        </ul>
      </section>
      <section class="fact" aria-labelledby="f-lang">
        <h3 id="f-lang" class="about__h mono caps">Languages</h3>
        <ul role="list" class="fact__langs">
          {languages.map((l) => (
            <li><span>{l.name}</span> <span class="muted">{l.level}</span></li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-7) var(--space-6);
  }
  .about__prose {
    grid-column: 1 / span 6;
    color: var(--ink-2);
  }
  .about__lead {
    font-family: var(--f-display);
    font-size: clamp(1.5rem, 1.15rem + 1.1vw, 2.15rem);
    line-height: 1.22;
    color: var(--ink);
  }
  .about__record {
    grid-column: 8 / span 5;
  }
  .about__h {
    color: var(--warm-ink);
    font-weight: 500;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule-strong);
    margin-bottom: var(--space-3);
  }
  .record__item {
    position: relative;
    padding: var(--space-3) 0 var(--space-4) var(--space-5);
    border-left: 1px solid var(--rule-strong);
  }
  .record__item::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 1.05rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .record__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--f-mono);
    font-size: var(--fs-micro);
    color: var(--ink-3);
  }
  .record__type {
    color: var(--accent);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .record__title {
    margin-top: var(--space-1);
    font-weight: 600;
  }
  .record__sub {
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .record__points {
    margin-top: var(--space-2);
    padding-left: 1.1em;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .record__points li + li {
    margin-top: var(--space-1);
  }
  .record__points li::marker {
    color: var(--warm-ink);
  }
  .record__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    margin-top: var(--space-1);
    font-size: var(--fs-small);
  }
  .record__links a {
    display: inline-flex;
    gap: 0.3rem;
    min-height: 28px;
    align-items: center;
  }
  .record__links .mono {
    color: var(--warm-ink);
  }

  .about__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }
  .fact__list {
    padding-left: 1.1em;
    color: var(--ink-2);
  }
  .fact__list li + li {
    margin-top: var(--space-1);
  }
  .fact__list li::marker {
    color: var(--warm-ink);
  }
  .fact__note {
    margin-top: var(--space-3);
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .fact__langs {
    display: grid;
    gap: var(--space-2);
  }
  .fact__langs li {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--space-1);
  }
  @media (max-width: 64rem) {
    .about__prose,
    .about__record {
      grid-column: 1 / -1;
    }
    .about__facts {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 40rem) {
    .about__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
