---
import SectionHead from './SectionHead.astro';
import ExtLink from './ExtLink.astro';
import Icon from './Icon.astro';
import { social, email, resume } from '../content/site';
import { url } from '../lib/url';
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap wrap--wide">
    <SectionHead no="05" title="Contact" id="contact-title" />
    <div class="contact__grid">
      <p class="contact__line" data-reveal="mask">
        Email is the quickest way to reach me. Messages about roles, research, or a dataset worth a look are always welcome.
      </p>
      <div class="contact__actions">
        <ExtLink href={social.email.href} class="contact__email">{email}</ExtLink>
        <ul role="list" class="contact__list">
          <li>
            <ExtLink href={social.linkedin.href} class="link-arrow"><Icon name="linkedin" /> LinkedIn</ExtLink>
          </li>
          <li>
            <ExtLink href={social.github.href} class="link-arrow"><Icon name="github" /> GitHub · {social.github.handle}</ExtLink>
          </li>
          <li>
            <a class="link-arrow" href={url(resume.page)}><Icon name="doc" /> Résumé (web)</a>
          </li>
          {resume.pdf && (
            <li>
              <a class="link-arrow" href={url(resume.pdf)} download><Icon name="download" /> Résumé (PDF)</a>
            </li>
          )}
        </ul>
        <p class="contact__note muted">Based in Busan, Korea (KST, UTC+9). No contact form, so nothing you send is stored by this site.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-6);
    align-items: start;
  }
  .contact__line {
    grid-column: 1 / span 7;
    font-family: var(--f-display);
    font-size: clamp(1.8rem, 1.2rem + 2vw, 3.1rem);
    line-height: 1.12;
  }
  .contact__actions {
    grid-column: 8 / span 5;
  }
  .contact__actions :global(.contact__email) {
    display: inline-block;
    /* mono, not the display serif: its '1' reads as 'l', and an email must be unambiguous */
    font-family: var(--f-mono);
    font-size: clamp(1rem, 0.85rem + 0.5vw, 1.3rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
    text-decoration-color: var(--accent-deco);
    padding-block: 0.3rem;
  }
  .contact__list {
    margin-top: var(--space-4);
    display: grid;
  }
  .contact__list :global(.link-arrow svg) {
    width: 1.05em;
    height: 1.05em;
  }
  .contact__note {
    margin-top: var(--space-4);
    font-size: var(--fs-small);
  }
  @media (max-width: 52rem) {
    .contact__line,
    .contact__actions {
      grid-column: 1 / -1;
    }
  }
</style>
