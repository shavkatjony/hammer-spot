---
import SectionHead from './SectionHead.astro';
import ExtLink from './ExtLink.astro';
import Icon from './Icon.astro';
import { getContent, social, email, resume, personalSite } from '../content';
import { ui } from '../content/ui';
import { getLang } from '../lib/i18n';
import { url } from '../lib/url';
const lang = getLang(Astro.url);
const t = ui[lang].contact;
const { identity } = getContent(lang);
// CV buttons: the page's own language first.
const cvs = [
  { href: url(resume.en.file), lang: 'en', parts: ['', t.cvEn] },
  { href: url(resume.kr.file), lang: 'ko', parts: t.cvKo },
];
if (lang === 'ko') cvs.reverse();
---
<section class="section contact band-yale" id="contact" aria-labelledby="contact-title">
  <div class="contact__topo" aria-hidden="true"></div>
  <div class="wrap wrap--wide contact__inner">
    <SectionHead no="06" title={t.title} id="contact-title" />
    <div class="contact__grid">
      <div class="contact__lead">
        <p class="contact__line" data-reveal="mask">{t.line}</p>
        <p class="contact__note">
          {t.note(identity.location.city, identity.location.country, identity.visaDetail, identity.availability.scope)}
        </p>
      </div>
      <div class="contact__actions">
        <ExtLink href={social.email.href} class="contact__email">{email}</ExtLink>
        <div class="contact__buttons">
          <ExtLink href={social.email.href} class="btn btn--primary"><Icon name="mail" /> {t.emailMe}</ExtLink>
          {cvs.map((c) => (
            <a class="btn btn--ghost" href={c.href} download hreflang={c.lang}>
              <Icon name="download" /> <span>{c.parts[0]}{c.lang === 'ko' ? <span lang="ko">{c.parts[1]}</span> : c.parts[1]}</span>
            </a>
          ))}
        </div>
        <div class="contact__buttons">
          <ExtLink href={social.telegram.href} class="btn btn--ghost">
            <Icon name="telegram" /> Telegram
          </ExtLink>
          {personalSite.href ? (
            <ExtLink href={personalSite.href} class="btn btn--ghost"><Icon name="globe" /> {t.personalSite}</ExtLink>
          ) : (
            <span class="btn btn--ghost contact__soon"><Icon name="globe" /> {t.personalSite} · {t.soon}</span>
          )}
        </div>
        <ul role="list" class="contact__list">
          <li><ExtLink href={social.linkedin.href} class="link-arrow"><Icon name="linkedin" /> LinkedIn</ExtLink></li>
          <li><ExtLink href={social.github.href} class="link-arrow"><Icon name="github" /> GitHub · {social.github.handle}</ExtLink></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    overflow: hidden;
  }
  .contact__soon {
    border-style: dashed;
    cursor: default;
  }
  .contact__soon:hover {
    transform: none;
  }
  .contact__topo {
    position: absolute;
    inset: 0;
    background: var(--ink);
    -webkit-mask: url('../assets/textures/topo.svg') 85% 40% / 1500px auto no-repeat;
    mask: url('../assets/textures/topo.svg') 85% 40% / 1500px auto no-repeat;
    opacity: 0.09;
    pointer-events: none;
  }
  .contact__inner {
    position: relative;
  }
  .contact__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-6);
    align-items: start;
  }
  .contact__lead {
    grid-column: 1 / span 7;
  }
  .contact__line {
    font-family: var(--f-display);
    font-size: clamp(1.8rem, 1.25rem + 2vw, 3.1rem);
    line-height: 1.12;
    color: var(--ink);
  }
  .contact__note {
    margin-top: var(--space-5);
    max-width: 54ch;
    color: var(--ink-2);
  }
  .contact__actions {
    grid-column: 8 / span 5;
  }
  .contact__actions :global(.contact__email) {
    display: inline-block;
    font-family: var(--f-mono); /* the display serif's "1" reads as "l": an email must be unambiguous */
    font-size: clamp(0.98rem, 0.85rem + 0.45vw, 1.25rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
    color: var(--ink);
    text-decoration-color: var(--accent);
    padding-block: 0.3rem;
  }
  .contact__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .contact__buttons :global(.btn--ghost) {
    border-color: var(--ink);
    color: var(--ink);
  }
  .contact__buttons :global(.btn--ghost:hover) {
    background: var(--ink);
    color: var(--c-yale-deep);
  }
  .contact__list {
    margin-top: var(--space-4);
    display: grid;
  }
  .contact__list :global(.link-arrow) {
    color: var(--ink);
  }
  .contact__list :global(.link-arrow:hover) {
    color: var(--accent);
  }
  @media (max-width: 52rem) {
    .contact__lead,
    .contact__actions {
      grid-column: 1 / -1;
    }
    .contact__buttons :global(.btn) {
      flex: 1 1 12rem;
    }
  }
</style>
