---
/** External link: validated URL, new tab, and no opener/referrer leakage. */
import { safeHref } from '../lib/url';
interface Props {
  href: string;
  class?: string;
  label?: string; // accessible name override
  newTab?: boolean;
  [key: string]: unknown;
}
const { href, class: cls, label, newTab = true, ...rest } = Astro.props;
const safe = safeHref(href);
const isMail = safe.startsWith('mailto:');
---
<a
  href={safe}
  class={cls}
  aria-label={label}
  target={newTab && !isMail ? '_blank' : undefined}
  rel={newTab && !isMail ? 'noopener noreferrer' : undefined}
  {...rest}
><slot />{newTab && !isMail && <span class="visually-hidden"> (opens in a new tab)</span>}</a>
