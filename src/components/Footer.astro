---
import ExtLink from './ExtLink.astro';
import { identity, social, resume, meta } from '../content/site';
import { url } from '../lib/url';
const year = meta.updated.slice(0, 4);
---
<footer class="footer surface-dark">
  <div class="wrap wrap--wide">
    <div class="footer__horizon" aria-hidden="true">
      <span class="footer__sun"></span>
    </div>
    <div class="footer__grid">
      <div class="footer__sig">
        <p class="footer__mark">{identity.handle}</p>
        <p class="mono muted">Field archive · {identity.location.city} · {identity.location.coords}</p>
      </div>
      <nav class="footer__col" aria-label="Contact and profiles">
        <h2 class="mono muted">Correspondence</h2>
        <ul role="list">
          <li><ExtLink href={social.email.href} class="footer__email">{social.email.handle}</ExtLink></li>
          <li><ExtLink href={social.github.href}>GitHub · {social.github.handle}</ExtLink></li>
          <li><ExtLink href={social.linkedin.href}>LinkedIn</ExtLink></li>
        </ul>
      </nav>
      <nav class="footer__col" aria-label="Site">
        <h2 class="mono muted">Index</h2>
        <ul role="list">
          <li><a href={url('#work')}>Selected work</a></li>
          <li><a href={url('#notes')}>Field notes</a></li>
          <li><a href={url('#toolkit')}>Toolkit</a></li>
          <li><a href={url(resume.page)}>Résumé</a></li>
        </ul>
      </nav>
      <div class="footer__col">
        <h2 class="mono muted">Colophon</h2>
        <p>
          Built with Astro and three.js. Set in Instrument Serif, IBM Plex Sans and IBM Plex Mono, all self-hosted.
          No trackers, no cookies, no third-party scripts.
        </p>
      </div>
    </div>
    <div class="footer__base mono muted">
      <span>© {year} {identity.name}</span>
      <span>Last revised {meta.updated}</span>
      <a href="#main" class="footer__top">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--bg);
    color: var(--ink);
    padding-block: var(--space-8) var(--space-6);
    overflow: hidden;
  }
  .footer__horizon {
    position: relative;
    height: 1px;
    background: var(--rule);
    margin-bottom: var(--space-8);
  }
  .footer__sun {
    position: absolute;
    right: 12%;
    bottom: 0;
    width: 3.2rem;
    height: 1.6rem;
    border-radius: 3.2rem 3.2rem 0 0;
    background: var(--accent-deco);
    opacity: 0.9;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: var(--space-7) var(--space-6);
  }
  .footer__mark {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    line-height: 1;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-3);
  }
  .footer__col h2 {
    font-family: var(--f-mono);
    font-size: var(--fs-micro);
    margin-bottom: var(--space-3);
  }
  .footer__col ul li + li {
    margin-top: var(--space-2);
  }
  .footer__col a {
    display: inline-block;
    padding-block: 0.3rem;
    text-decoration-color: var(--rule);
    overflow-wrap: anywhere;
  }
  .footer__col :global(.footer__email) {
    font-family: var(--f-mono);
    font-size: 0.78rem;
  }
  .footer__col p {
    color: var(--ink-2);
    font-size: var(--fs-small);
    max-width: 34ch;
  }
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule-soft);
  }
  .footer__top {
    margin-left: auto;
    text-decoration: none;
  }
  @media (max-width: 52rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__sig {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 30rem) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
    .footer__top {
      margin-left: 0;
    }
  }
</style>
