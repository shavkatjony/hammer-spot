---
import ExtLink from './ExtLink.astro';
import { getContent, social, resume, personalSite } from '../content';
import { ui } from '../content/ui';
import { getLang, lurl } from '../lib/i18n';
import { url } from '../lib/url';
const lang = getLang(Astro.url);
const t = ui[lang].footer;
const n = ui[lang].nav;
const { identity, meta } = getContent(lang);
const year = meta.updated.slice(0, 4);
const [licA, licB] = t.licenceText(year, identity.name);
// CV links: the page's own language first.
const cvs = [
  { href: url(resume.en.file), lang: 'en', parts: ['', n.cvEn, ''] },
  { href: url(resume.kr.file), lang: 'ko', parts: n.cvKo },
];
if (lang === 'ko') cvs.reverse();
---
<footer class="footer band-coffee">
  <div class="wrap wrap--wide">
    <div class="footer__horizon" aria-hidden="true">
      <span class="footer__sun"></span>
    </div>
    <div class="footer__grid">
      <div class="footer__sig">
        <p class="footer__mark">{identity.name}</p>
        <p class="mono muted">{identity.title} · {identity.location.city} · {identity.location.coords}</p>
      </div>
      <nav class="footer__col" aria-label={t.profiles}>
        <h2 class="mono muted">{t.correspondence}</h2>
        <ul role="list">
          <li><ExtLink href={social.email.href} class="footer__email">{social.email.handle}</ExtLink></li>
          <li><ExtLink href={social.github.href}>GitHub · {social.github.handle}</ExtLink></li>
          <li><ExtLink href={social.linkedin.href}>LinkedIn</ExtLink></li>
          <li><ExtLink href={social.telegram.href}>Telegram</ExtLink></li>
          {personalSite.href && <li><ExtLink href={personalSite.href}>{ui[lang].contact.personalSite}</ExtLink></li>}
        </ul>
      </nav>
      <nav class="footer__col" aria-label={t.site}>
        <h2 class="mono muted">{t.index}</h2>
        <ul role="list">
          <li><a href={lurl(lang, '#experience')}>{t.links.experience}</a></li>
          <li><a href={lurl(lang, '#work')}>{t.links.work}</a></li>
          <li><a href={lurl(lang, '#notes')}>{t.links.notes}</a></li>
          <li><a href={lurl(lang, '#toolkit')}>{t.links.toolkit}</a></li>
          {cvs.map((c) => (
            <li>
              <a href={c.href} download hreflang={c.lang}><span>{c.parts[0]}{c.lang === 'ko' ? <span lang="ko">{c.parts[1]}</span> : c.parts[1]}{c.parts[2]}</span></a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="footer__col">
        <h2 class="mono muted">{t.licence}</h2>
        <p>
          {licA}<ExtLink href="https://opensource.org/license/mit" class="footer__inline">MIT License</ExtLink>{licB}
        </p>
      </div>
    </div>
    <div class="footer__base mono muted">
      <span>© {year} {identity.name}</span>
      <span>{t.revised} {meta.updated}</span>
      <a href="#main" class="footer__top">{t.top}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--bg);
    color: var(--ink);
    padding-block: var(--space-8) var(--space-6);
    overflow: hidden;
  }
  .footer__horizon {
    position: relative;
    height: 1px;
    background: var(--rule);
    margin-bottom: var(--space-8);
  }
  .footer__sun {
    position: absolute;
    right: 12%;
    bottom: 0;
    width: 3.2rem;
    height: 1.6rem;
    border-radius: 3.2rem 3.2rem 0 0;
    background: var(--c-gold);
    opacity: 0.95;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: var(--space-7) var(--space-6);
  }
  .footer__mark {
    font-family: var(--f-display);
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.015em;
    margin-bottom: var(--space-3);
  }
  .footer__col h2 {
    font-family: var(--f-mono);
    font-size: var(--fs-micro);
    margin-bottom: var(--space-3);
  }
  .footer__col ul li + li {
    margin-top: var(--space-2);
  }
  .footer__col p :global(.footer__inline) {
    display: inline;
    padding: 0;
  }
  .footer__col a {
    display: inline-block;
    padding-block: 0.3rem;
    text-decoration-color: var(--rule);
    overflow-wrap: anywhere;
  }
  .footer__col :global(.footer__email) {
    font-family: var(--f-mono);
    font-size: 0.78rem;
  }
  .footer__col p {
    color: var(--ink-2);
    font-size: var(--fs-small);
    max-width: 34ch;
  }
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule-soft);
  }
  .footer__top {
    margin-left: auto;
    text-decoration: none;
  }
  @media (max-width: 52rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__sig {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 30rem) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
    .footer__top {
      margin-left: 0;
    }
  }
</style>
