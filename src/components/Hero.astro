---
/**
 * Opening scene. Reading order is deliberate (F-pattern): who (name) → what (positioning) →
 * proof of availability → actions, with the portrait on the first horizontal sweep and a
 * five-project index resting on the dunes so evidence is visible in the first viewport.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import DuneFallback from './DuneFallback.astro';
import Icon from './Icon.astro';
import ExtLink from './ExtLink.astro';
import { identity, social, resume, projects } from '../content/site';
import { url } from '../lib/url';

// Drop a photo at src/assets/portrait.(jpg|jpeg|png|webp|avif) and it is used automatically.
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp,avif}', { eager: true });
const portrait = Object.values(found)[0]?.default ?? null;
const cvHref = resume.pdf ? url(resume.pdf) : url(resume.page);
---
<section class="hero" aria-labelledby="hero-name" data-hero>
  <div class="hero__scene hero-scene" data-hero-scene>
    <div class="hero__fallback" data-hero-fallback>
      <DuneFallback />
    </div>
  </div>

  <div class="hero__inner wrap wrap--wide">
    <div class="hero__copy">
      <p class="hero__eyebrow mono caps">{identity.roles.join(' · ')}</p>
      <h1 id="hero-name" class="hero__name">
        <span class="hero__first">{identity.firstName}</span>{' '}
        <span class="hero__last">{identity.lastName}</span>
      </h1>
      <p class="hero__position">
        Data Scientist building <em>production-grade ML&nbsp;systems</em>.
      </p>
      <p class="hero__statement">{identity.statement}</p>
      {identity.availability.open && (
        <p class="hero__open">
          <span class="chip-open">{identity.availability.short}</span>
          <span class="hero__open-text">
            {identity.availability.detail} Based in {identity.location.city}, {identity.location.country}.
          </span>
        </p>
      )}
      <div class="hero__actions" data-horizon-anchor>
        <a class="btn btn--primary" href="#work">View selected work <Icon name="arrow-down" /></a>
        <a class="btn btn--ghost hero__cv" href={cvHref} download={resume.pdf ? '' : undefined}>
          <Icon name="download" /> Download CV <span class="hero__cv-fmt mono">PDF</span>
        </a>
        <ul class="hero__social" role="list" aria-label="Profiles">
          <li><ExtLink href={social.github.href} class="hero__icon" label="GitHub profile"><Icon name="github" /></ExtLink></li>
          <li><ExtLink href={social.linkedin.href} class="hero__icon" label="LinkedIn profile"><Icon name="linkedin" /></ExtLink></li>
          <li><ExtLink href={social.email.href} class="hero__icon" label={`Email ${social.email.handle}`}><Icon name="mail" /></ExtLink></li>
        </ul>
      </div>
    </div>

    <div class="hero__plate" data-portrait={portrait ? 'photo' : 'monogram'}>
      <figure class="hero__mat">
        <span class="hero__tick hero__tick--tl" aria-hidden="true"></span>
        <span class="hero__tick hero__tick--br" aria-hidden="true"></span>
        {portrait ? (
          <Picture
            src={portrait}
            formats={['avif', 'webp']}
            widths={[320, 480, 640, 960]}
            sizes="(max-width: 52rem) 40vw, 26rem"
            alt={`Portrait of ${identity.name}`}
            class="hero__photo"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="hero__monogram" role="img" aria-label={`${identity.name}, monogram`}>
            <svg viewBox="0 0 200 250" aria-hidden="true" focusable="false">
              <circle class="mono-sun" cx="128" cy="96" r="30" />
              <path class="mono-dune" d="M0 178 C46 158 74 160 104 172 C134 184 160 176 200 160 L200 250 L0 250 Z" />
              <path class="mono-dune2" d="M0 206 C40 194 82 198 120 210 C150 219 176 214 200 206 L200 250 L0 250 Z" />
              <text class="mono-text" x="22" y="132">SY</text>
            </svg>
          </div>
        )}
        <figcaption class="hero__plate-cap mono">
          <span>{identity.name}</span>{' '}
          <span>{identity.location.city} · {identity.location.coords}</span>
        </figcaption>
      </figure>
    </div>
  </div>

  <nav class="hero__index wrap wrap--wide" aria-label="Selected work at a glance">
    <p class="hero__index-label mono caps">At a glance</p>
    <ol class="hero__index-list" role="list">
      {projects.map((p) => (
        <li>
          <a href={url(`work/${p.slug}/`)} class="hero__index-link">
            <span class="hero__index-no mono">{p.index}</span>
            <span class="hero__index-title">{p.short}</span>{' '}
            <span class="hero__index-value">{p.strip.value}</span>{' '}
            <span class="hero__index-metric mono">{p.strip.label}</span>
            {p.status === 'In development' && <span class="hero__index-status mono">in development</span>}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</section>

<style>
  .hero {
    --scene-sky: var(--hero-sky);
    --scene-sand: #e6d3b6;
    --scene-sand-dark: #bc9e82;
    --scene-sun: #dba12c;
    --scene-light: #f6c979;
    --scene-hemi-sky: #efe5d8;
    --scene-hemi-ground: #948a82;
    --scene-dust: #fff7ea;
    position: relative;
    isolation: isolate;
    min-height: max(100svh, 46rem);
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: var(--nav-h);
    background: var(--hero-sky);
    overflow: hidden;
  }
  :global(:root[data-theme='dark']) .hero {
    --scene-sand: #6a4a3e;
    --scene-sand-dark: #3a2b36;
    --scene-sun: #dba12c;
    --scene-light: #e59a62;
    --scene-hemi-sky: #5b4d72;
    --scene-hemi-ground: #120f16;
    --scene-dust: #cdbfd6;
  }

  /* ---- scene ---- */
  .hero__scene {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  /* Static desert: its far crest (130 of 1600 units) lands just under the buttons. --horizon-y is
     measured by site.ts; without JavaScript the crest falls at about two thirds of the hero. */
  .hero__fallback {
    --dune-w: max(100vw, 56rem);
    position: absolute;
    left: 50%;
    width: var(--dune-w);
    top: calc(var(--horizon-y, 64%) + 1rem - var(--dune-w) * 0.08125);
    bottom: 0;
    translate: -50% 0;
    /* below the drawing, the front dune's colour carries on to the bottom of the hero */
    background: linear-gradient(to bottom, transparent calc(var(--dune-w) * 0.22), var(--dune-front) 0);
  }
  .hero__scene :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1200ms var(--ease-in-out);
  }
  .hero__scene :global(canvas.is-ready) {
    opacity: 1;
  }

  /* ---- layout ---- */
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-6) clamp(2rem, 5vw, 6rem);
    align-items: start;
    padding-top: clamp(2rem, 7vh, 5rem);
    padding-bottom: var(--space-6);
  }
  .hero__eyebrow {
    color: var(--warm-ink);
    font-weight: 500;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-4);
  }
  .hero__name {
    font-size: var(--fs-name);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.022em;
  }
  .hero__name span {
    display: inline-block;
  }
  .hero__position {
    margin-top: var(--space-4);
    font-family: var(--f-display);
    font-size: var(--fs-statement);
    line-height: 1.18;
    letter-spacing: -0.008em;
    color: var(--ink);
    max-width: 24ch;
  }
  .hero__position em {
    font-style: italic;
    color: var(--accent);
  }
  .hero__statement {
    margin-top: var(--space-4);
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 50ch;
  }
  .hero__open {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-5);
    font-size: var(--fs-small);
    color: var(--ink-2);
    max-width: 58ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .hero__cv {
    background: var(--hero-sky);
  }
  .hero__cv-fmt {
    font-size: 0.68rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid currentColor;
    border-radius: 2px;
    opacity: 0.8;
  }
  .hero__social {
    display: flex;
    gap: var(--space-1);
    margin-left: var(--space-2);
  }
  .hero__social :global(.hero__icon) {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    color: var(--ink);
    border-radius: var(--radius);
    transition: color var(--dur-1) ease, transform var(--dur-1) var(--ease-out), background-color var(--dur-1) ease;
  }
  .hero__social :global(.hero__icon svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .hero__social :global(.hero__icon:hover) {
    color: var(--accent);
    background: var(--surface);
    transform: translateY(-2px);
  }

  /* ---- portrait plate ---- */
  .hero__plate {
    justify-self: end;
    width: min(100%, 25rem);
    margin-top: var(--space-2);
  }
  .hero__mat {
    position: relative;
    padding: 10px;
    background: var(--surface);
    border: 1px solid var(--ink);
    border-radius: 2px;
    box-shadow: var(--shadow-plate);
    transform: perspective(var(--perspective)) rotateY(-3deg) rotateX(1deg);
    transform-origin: right center;
    transition: transform var(--dur-3) var(--ease-settle);
  }
  .hero__plate:hover .hero__mat {
    transform: perspective(var(--perspective)) rotateY(0deg) rotateX(0deg) translateY(var(--lift));
  }
  .hero__mat :global(picture),
  .hero__mat :global(img) {
    width: 100%;
  }
  .hero__mat :global(.hero__photo) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 28%;
    filter: saturate(0.92) contrast(1.02);
  }
  .hero__tick {
    position: absolute;
    width: 22px;
    height: 22px;
    border-color: var(--mark);
    border-style: solid;
    border-width: 0;
    z-index: 1;
  }
  .hero__tick--tl {
    top: -6px;
    left: -6px;
    border-top-width: 3px;
    border-left-width: 3px;
  }
  .hero__tick--br {
    bottom: -6px;
    right: -6px;
    border-bottom-width: 3px;
    border-right-width: 3px;
  }
  .hero__monogram {
    aspect-ratio: 4 / 5;
    background: var(--surface-2);
  }
  .hero__monogram svg {
    width: 100%;
    height: 100%;
  }
  .mono-sun {
    fill: var(--mark);
  }
  .mono-dune {
    fill: color-mix(in oklab, var(--c-brick) 55%, var(--surface-2));
  }
  .mono-dune2 {
    fill: color-mix(in oklab, var(--c-hickory) 70%, var(--surface-2));
  }
  .mono-text {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 84px;
    font-weight: 500;
    fill: var(--ink);
    letter-spacing: -2px;
  }
  .hero__plate-cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-3);
    padding: 9px 2px 0;
    color: var(--ink-3);
    font-size: var(--fs-micro);
  }

  /* ---- at-a-glance index on the dunes ---- */
  .hero__index {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: stretch;
    gap: var(--space-5);
    padding-bottom: var(--space-5);
  }
  .hero__index-label {
    align-self: center;
    color: var(--ink);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    letter-spacing: 0.12em;
    font-weight: 500;
  }
  .hero__index-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    background: var(--surface);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow-plate);
  }
  .hero__index-list li + li {
    border-left: 1px solid var(--rule);
  }
  .hero__index-link {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'no title' 'value value' 'metric metric' 'status status';
    align-content: start;
    gap: 0.15rem 0.6rem;
    height: 100%;
    padding: var(--space-4) var(--space-4) var(--space-4);
    text-decoration: none;
    color: var(--ink);
    transition: background-color var(--dur-1) ease;
  }
  .hero__index-link::after {
    content: '';
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .hero__index-link:hover,
  .hero__index-link:focus-visible {
    background: var(--bg);
    color: var(--ink);
  }
  .hero__index-link:hover::after,
  .hero__index-link:focus-visible::after {
    transform: scaleX(1);
  }
  .hero__index-no {
    grid-area: no;
    color: var(--warm-ink);
    font-weight: 500;
    padding-top: 0.1rem;
  }
  .hero__index-title {
    grid-area: title;
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .hero__index-value {
    grid-area: value;
    margin-top: var(--space-2);
    font-family: var(--f-display);
    font-size: clamp(1.35rem, 1rem + 0.9vw, 1.85rem);
    font-weight: 500;
    line-height: 1.05;
  }
  .hero__index-metric {
    grid-area: metric;
    color: var(--ink-3);
  }
  .hero__index-status {
    grid-area: status;
    justify-self: start;
    margin-top: var(--space-2);
    padding: 0.05rem 0.5rem;
    border: 1px dashed currentColor;
    border-radius: 999px;
    color: var(--warm-ink);
    font-size: 0.68rem;
    font-weight: 500;
  }

  /* ---- responsive ---- */
  @media (max-width: 80rem) {
    .hero__index-list {
      grid-template-columns: repeat(5, minmax(9.5rem, 1fr));
      overflow-x: auto;
    }
  }
  @media (max-width: 52rem) {
    .hero {
      min-height: auto;
    }
    .hero__inner {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
      grid-template-areas: 'plate eyebrow' 'plate name';
      grid-template-rows: 1fr auto;
      gap: var(--space-4) var(--space-4);
      padding-top: var(--space-5);
    }
    .hero__copy {
      display: contents;
    }
    .hero__plate {
      grid-area: plate;
      justify-self: stretch;
      width: 100%;
      margin-top: 0;
    }
    .hero__mat {
      padding: 6px;
      transform: none;
    }
    .hero__plate-cap {
      display: none;
    }
    .hero__eyebrow {
      grid-area: eyebrow;
      align-self: end;
      margin: 0;
      font-size: 0.68rem;
    }
    .hero__name {
      grid-area: name;
      align-self: end;
      font-size: clamp(2.05rem, 1.2rem + 4.6vw, 2.9rem);
    }
    .hero__name span {
      display: block;
    }
    .hero__position,
    .hero__statement,
    .hero__open,
    .hero__actions {
      grid-column: 1 / -1;
    }
    .hero__position {
      margin-top: var(--space-2);
      max-width: none;
    }
    .hero__actions .btn {
      flex: 1 1 12rem;
    }
    .hero__social {
      margin-left: 0;
    }
    .hero__index {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      margin-top: 30vw;
    }
    .hero__index-label {
      writing-mode: horizontal-tb;
      transform: none;
      align-self: start;
    }
    .hero__index-list {
      grid-template-columns: 1fr;
      overflow: visible;
    }
    .hero__index-list li + li {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    .hero__index-link {
      grid-template-columns: 2rem 1fr auto;
      grid-template-areas: 'no title value' 'no metric value' 'no status status';
      align-items: center;
      padding: var(--space-3) var(--space-4);
    }
    .hero__index-value {
      margin-top: 0;
      font-size: 1.25rem;
      text-align: right;
    }
    .hero__index-status {
      margin-top: var(--space-1);
    }
  }

  /* ---- opening choreography (first visit in a session, motion allowed) ---- */
  @keyframes rise-mask {
    from { clip-path: inset(100% 0 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes plate-in {
    from { opacity: 0; clip-path: inset(0 0 100% 0); }
    to { opacity: 1; clip-path: inset(-20px -20px -20px -20px); }
  }
  :global(html.motion:not(.intro-seen)) .hero__fallback { animation: rise-mask 1200ms var(--ease-in-out) 60ms backwards; }
  :global(html.motion:not(.intro-seen)) .hero__eyebrow { animation: fade-up 600ms var(--ease-out) 120ms backwards; }
  :global(html.motion:not(.intro-seen)) .hero__first { animation: fade-up 800ms var(--ease-settle) 200ms backwards; }
  :global(html.motion:not(.intro-seen)) .hero__last { animation: fade-up 800ms var(--ease-settle) 300ms backwards; }
  :global(html.motion:not(.intro-seen)) .hero__plate { animation: plate-in 1100ms var(--ease-settle) 260ms backwards; }
  :global(html.motion:not(.intro-seen)) .hero__position { animation: fade-up 700ms var(--ease-out) 460ms backwards; }
  :global(html.motion:not(.intro-seen)) .hero__statement { animation: fade-up 700ms var(--ease-out) 560ms backwards; }
  :global(html.motion:not(.intro-seen)) .hero__open { animation: fade-up 700ms var(--ease-out) 640ms backwards; }
  :global(html.motion:not(.intro-seen)) .hero__actions { animation: fade-up 700ms var(--ease-out) 720ms backwards; }
  :global(html.motion:not(.intro-seen)) .hero__index { animation: fade-up 800ms var(--ease-out) 880ms backwards; }
  :global(html.motion:not(.intro-seen) .site-nav) { animation: fade-in 600ms ease 400ms backwards; }
</style>
