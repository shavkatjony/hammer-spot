---
import Icon from './Icon.astro';
import CvDownload from './CvDownload.astro';
import { url } from '../lib/url';
import { getLang, lurl, altHref, LANGS } from '../lib/i18n';
import { ui } from '../content/ui';
import { getContent, resume } from '../content';

interface Props {
  onDark?: boolean;
}
const { onDark = false } = Astro.props;
const lang = getLang(Astro.url);
const t = ui[lang];
const { identity } = getContent(lang);
const L = t.nav.links;

const links = [
  { href: lurl(lang, '#experience'), label: L.experience },
  { href: lurl(lang, '#work'), label: L.work },
  { href: lurl(lang, '#notes'), label: L.notes },
  { href: lurl(lang, '#toolkit'), label: L.toolkit },
  { href: lurl(lang, '#about'), label: L.about },
  { href: lurl(lang, '#contact'), label: L.contact },
];
// CV links in the mobile menu: the page's own language first.
const cvEn = { href: url(resume.en.file), hreflang: 'en', parts: ['', t.nav.cvEn, ''] };
const cvKo = { href: url(resume.kr.file), hreflang: 'ko', parts: t.nav.cvKo };
const cvs = lang === 'ko' ? [cvKo, cvEn] : [cvEn, cvKo];
const langs = LANGS.map((l) => ({ l, href: altHref(Astro.url, l), current: l === lang }));
---
<header class:list={['site-nav', { 'site-nav--on-dark': onDark }]} data-nav>
  <div class="site-nav__inner wrap wrap--wide">
    <a class="brand" href={lurl(lang)} aria-label={t.nav.home(identity.name)}>
      <svg class="brand__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="10" r="5" />
        <path d="M1 16.5h22" />
        <path d="M5 20h14" />
      </svg>
      <span class="brand__word">{identity.name}</span>{' '}
      <span class="brand__role mono">{identity.title}</span>
    </a>

    <nav class="primary" aria-label={t.nav.primary}>
      <ul role="list" class="primary__list" id="nav-menu" data-menu>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        {cvs.map((c) => (
          <li class="primary__resume-m">
            <a href={c.href} download hreflang={c.hreflang}><span>{c.parts[0]}{c.hreflang === 'ko' ? <span lang="ko">{c.parts[1]}</span> : c.parts[1]}{c.parts[2]}</span></a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <nav class="lang-switch" aria-label={t.nav.language}>
        {langs.map((x) => (
          <a
            class="lang-switch__opt"
            href={x.href}
            hreflang={x.l}
            lang={x.l}
            aria-current={x.current ? 'true' : undefined}
            title={t.nav.langNames[x.l]}
          >{t.nav.langShort[x.l]}</a>
        ))}
      </nav>
      <div class="tools__resume"><CvDownload variant="nav" align="end" /></div>
      <button class="icon-btn" type="button" data-theme-toggle aria-pressed="false">
        <span class="visually-hidden">{t.nav.dark}</span>
        <Icon name="moon" class="icon-btn__moon" />
        <Icon name="sun" class="icon-btn__sun" />
      </button>
      <button class="menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="nav-menu">
        <span class="menu-btn__label">{t.nav.menu}</span>
        <span class="menu-btn__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-h);
    color: var(--ink);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color var(--dur-2) var(--ease-out), border-color var(--dur-2) var(--ease-out);
  }
  :global(.site-nav.is-solid) {
    background: var(--bg);
    border-bottom-color: var(--rule-soft);
  }
  /* over a dark page header: light ink until the bar turns solid */
  .site-nav--on-dark:not(:global(.is-solid)) {
    --ink: #eee6d9;
    --ink-3: #c4b6aa;
    --bg: #3e251e;
    --accent: #dba12c;
    --on-accent: #3d2614;
    --mark: #dba12c;
    --rule-strong: rgb(238 230 217 / 0.5);
  }
  .site-nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    text-decoration: none;
  }
  .brand__word {
    font-family: var(--f-display);
    font-size: 1.12rem;
    font-weight: 560;
    letter-spacing: -0.01em;
  }
  .brand__role {
    color: var(--ink-3);
    padding-left: 0.6rem;
    border-left: 1px solid var(--rule-strong);
  }
  .brand__mark {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .brand__mark circle {
    fill: var(--mark);
    stroke: none;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .brand:hover .brand__mark circle {
    transform: translateY(1.5px);
  }
  .primary {
    margin-left: auto;
  }
  .primary__list {
    display: flex;
    gap: var(--space-1);
  }
  .primary__list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.7rem;
    font-family: var(--f-mono);
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
    text-decoration: none;
    position: relative;
  }
  .primary__list a::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.6rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .primary__list a:hover::after,
  .primary__list a:focus-visible::after {
    transform: scaleX(1);
  }
  .primary__resume-m {
    display: none;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .tools__resume {
    display: inline-flex;
  }
  /* language switch: two options, the current one filled */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    padding: 2px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
  }
  .lang-switch__opt {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 0.7rem;
    border-radius: 999px;
    font-family: var(--f-mono);
    font-size: var(--fs-small);
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--dur-1) ease, color var(--dur-1) ease;
  }
  .lang-switch__opt:hover {
    color: var(--accent);
  }
  .lang-switch__opt[aria-current='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    cursor: pointer;
    border-radius: var(--radius);
  }
  .icon-btn :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    grid-area: 1 / 1;
    transition: transform var(--dur-2) var(--ease-out), opacity var(--dur-1) ease;
  }
  .icon-btn :global(.icon-btn__sun) {
    opacity: 0;
    transform: rotate(-40deg) scale(0.7);
  }
  :global(:root[data-theme='dark']) .icon-btn :global(.icon-btn__sun) {
    opacity: 1;
    transform: none;
  }
  :global(:root[data-theme='dark']) .icon-btn :global(.icon-btn__moon) {
    opacity: 0;
    transform: rotate(40deg) scale(0.7);
  }
  .icon-btn:hover {
    color: var(--accent);
  }
  .menu-btn {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 0.4rem 0 0.6rem;
    border: 0;
    background: transparent;
    font-family: var(--f-mono);
    font-size: var(--fs-small);
    cursor: pointer;
  }
  .menu-btn__bars {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .menu-btn__bars span {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .menu-btn[aria-expanded='true'] .menu-btn__bars span:first-child {
    transform: translateY(3px) rotate(25deg);
  }
  .menu-btn[aria-expanded='true'] .menu-btn__bars span:last-child {
    transform: translateY(-3px) rotate(-25deg);
  }

  /* the full title needs room: shown from 82rem up, next to the name */
  @media (max-width: 82rem) {
    .brand__role {
      display: none;
    }
  }
  @media (max-width: 30rem) {
    .site-nav__inner {
      gap: var(--space-2);
    }
    .brand__word {
      font-size: 1rem;
    }
    /* phones: the switch becomes one button naming the other language */
    .lang-switch__opt[aria-current='true'] {
      display: none;
    }
    .lang-switch__opt {
      padding: 0 0.7rem;
    }
    .brand__word {
      white-space: nowrap;
    }
    .menu-btn__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (max-width: 52rem) {
    .menu-btn {
      display: inline-flex;
    }
    .tools__resume {
      display: none;
    }
    .tools {
      margin-left: auto;
    }
    .primary {
      position: fixed;
      inset: var(--nav-h) 0 auto 0;
      margin: 0;
      pointer-events: none;
    }
    .primary__list {
      flex-direction: column;
      gap: 0;
      padding: var(--space-3) var(--gutter) var(--space-6);
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity var(--dur-1) ease, transform var(--dur-2) var(--ease-out), visibility 0s linear var(--dur-2);
    }
    :global(.primary__list.is-open) {
      visibility: visible;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      transition: opacity var(--dur-1) ease, transform var(--dur-2) var(--ease-out), visibility 0s;
    }
    .primary__list li {
      border-bottom: 1px solid var(--rule-soft);
    }
    .primary__list a {
      width: 100%;
      min-height: 52px;
      padding-inline: 0;
      font-family: var(--f-display);
      font-size: 1.75rem;
      letter-spacing: 0;
    }
    .primary__list a::after {
      display: none;
    }
    .primary__resume-m {
      display: block;
    }
  }
</style>
