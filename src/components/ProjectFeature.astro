---
import type { Project } from '../content/site';
import Figure from './figures/Figure.astro';
import Icon from './Icon.astro';
import ExtLink from './ExtLink.astro';
import Rich from './Rich.astro';
import { url } from '../lib/url';

interface Props {
  project: Project;
  flip?: boolean;
}
const { project: p, flip = false } = Astro.props;
const caseHref = url(`work/${p.slug}/`);
const dark = p.tone === 'coffee' || p.tone === 'yale';
const toneClass = p.tone === 'coffee' ? 'band-coffee' : p.tone === 'yale' ? 'band-yale' : `tone-${p.tone}`;
const secondary = p.tier === 'secondary';
const flagship = !!p.flagship;
const icon = (k: string) => (k === 'demo' ? 'play' : k === 'repo' ? 'github' : k === 'data' ? 'data' : 'doc');
---
<article
  class:list={['pf', toneClass, { 'pf--flip': flip, 'pf--dark': dark, 'pf--secondary': secondary, 'pf--flagship': flagship }]}
  aria-labelledby={`pf-${p.slug}`}
>
  {dark && <div class="pf__topo" aria-hidden="true"></div>}
  <div class="pf__inner wrap wrap--wide">
    <header class="pf__head" data-reveal="stagger">
      <span class="pf__index" aria-hidden="true">{p.index}</span>{' '}
      {flagship && <><span class="pf__flag mono caps">Flagship project</span>{' '}</>}
      <span class="pf__kicker mono caps">{p.kicker}</span>{' '}
      <span class="status" data-status={p.status}>{p.status}</span>{' '}
      {p.statusNote && <span class="pf__note">{p.statusNote}</span>}
      <span class="pf__year mono">{p.year}</span>
    </header>

    <div class="pf__grid">
      <div class="pf__visual">
        <a href={caseHref} class="pf__visual-link" tabindex="-1" aria-hidden="true" data-parallax>
          <Figure id={p.plate} compact frame={dark ? 'dark' : 'paper'} />
        </a>
        {flagship && p.plateExtra && (
          <div class="pf__extra" data-reveal="fade">
            <Figure id={p.plateExtra} compact />
          </div>
        )}
        {flagship && p.demonstrates && (
          <div class="pf__demo" data-reveal="fade">
            <p class="pf__demo-k mono caps">What it demonstrates</p>
            <ol class="pf__demo-list" role="list">
              {p.demonstrates.map((d, i) => (
                <li><span class="mono">{String(i + 1).padStart(2, '0')}</span> {d}</li>
              ))}
            </ol>
          </div>
        )}
      </div>

      <div class="pf__body">
        <h3 id={`pf-${p.slug}`} class={`pf__title vt-${p.slug}`} data-reveal="mask">
          <a href={caseHref}>{p.title}</a>
        </h3>
        <p class="pf__problem"><Rich text={p.problem} /></p>
        <dl class="pf__facts" data-reveal="fade">
          <div><dt class="mono caps">My part</dt><dd><Rich text={p.contribution} /></dd></div>
          <div><dt class="mono caps">Result</dt><dd><Rich text={p.result} /></dd></div>
        </dl>
        <ul class="pf__metrics" role="list" data-reveal="stagger">
          {p.metrics.map((m) => (
            <li>
              <span class="pf__metric-v">{m.value}</span>{' '}
              <span class="pf__metric-l">{m.label}</span>
            </li>
          ))}
        </ul>
        <ul class="tags pf__tags" role="list" aria-label="Methods">
          {p.methods.map((t) => <li class="tag">{t}</li>)}
        </ul>
        <p class="pf__stack mono"><span class="pf__stack-k">Stack</span> {p.stack.join(' · ')}</p>
        <div class="pf__actions">
          <a class="btn btn--primary" href={caseHref}>Read the case study <Icon name="arrow-ur" /></a>
          {p.links
            .filter((l) => l.kind !== 'data')
            .map((l) => (
              <ExtLink href={l.href} class="link-arrow">
                <Icon name={icon(l.kind) as 'play' | 'github' | 'doc'} /> {l.label}
              </ExtLink>
            ))}
          {!p.repoPublic && p.privateNote && <p class="pf__private mono">{p.privateNote}</p>}
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .pf {
    position: relative;
    background: var(--tone-bg);
    padding-block: clamp(3.5rem, 6vw, 6rem);
    overflow: hidden;
    border-top: 1px solid var(--rule);
  }
  .pf--dark {
    background: var(--bg);
    color: var(--ink);
    border-top: 0;
  }
  .pf__topo {
    position: absolute;
    inset: 0;
    background: var(--rule-strong);
    -webkit-mask: url('../assets/textures/topo.svg') center / cover no-repeat;
    mask: url('../assets/textures/topo.svg') center / cover no-repeat;
    opacity: 0.16; /* decorative: kept faint so text over a line keeps its contrast */
    pointer-events: none;
  }
  .pf__inner {
    position: relative;
  }

  /* header row: index · kicker · status · year */
  .pf__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    padding-bottom: var(--space-4);
    margin-bottom: clamp(1.75rem, 3vw, 2.75rem);
    border-bottom: 1px solid var(--rule-strong);
  }
  .pf__index {
    font-family: var(--f-display);
    font-size: clamp(2.6rem, 1.8rem + 2.4vw, 4.2rem);
    font-weight: 500;
    line-height: 0.8;
    color: var(--tone-ink, var(--accent));
    transition: transform var(--dur-2) var(--ease-out);
  }
  .pf--dark .pf__index {
    color: var(--accent);
  }
  .pf__kicker {
    color: var(--tone-ink, var(--ink-2));
    font-weight: 500;
  }
  .pf--dark .pf__kicker {
    color: var(--ink-2);
  }
  .pf__note {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .pf__year {
    margin-left: auto;
    color: var(--ink-3);
  }

  .pf__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-6) clamp(2rem, 4.5vw, 5rem);
    align-items: start;
  }
  .pf--flip .pf__visual {
    order: 2;
  }
  .pf__visual-link {
    display: block;
    text-decoration: none;
    transition: transform var(--dur-3) var(--ease-settle);
  }
  .pf__title {
    font-size: clamp(2rem, 1.35rem + 2vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.018em;
  }
  .pf__title a {
    text-decoration-line: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.14em;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--dur-2) var(--ease-out), color var(--dur-1) ease;
  }
  .pf__problem {
    margin-top: var(--space-4);
    font-family: var(--f-display);
    font-size: clamp(1.15rem, 1rem + 0.45vw, 1.4rem);
    line-height: 1.38;
    color: var(--ink);
    max-width: 44ch;
  }
  .pf__facts {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .pf__facts div {
    display: grid;
    grid-template-columns: 5.25rem 1fr;
    gap: var(--space-4);
  }
  .pf__facts dt {
    color: var(--tone-ink, var(--ink-3));
    padding-top: 0.32em;
    font-weight: 500;
  }
  .pf--dark .pf__facts dt {
    color: var(--ink-3);
  }
  .pf__facts dd {
    color: var(--ink-2);
    max-width: 56ch;
  }
  .pf__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule-strong);
  }
  .pf__metrics li {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }
  .pf__metric-v {
    font-family: var(--f-display);
    font-size: clamp(1.55rem, 1.15rem + 1.15vw, 2.3rem);
    font-weight: 500;
    line-height: 1;
    color: var(--ink);
  }
  .pf__metric-l {
    font-size: var(--fs-small);
    color: var(--ink-3);
    line-height: 1.35;
  }
  .pf__tags {
    margin-top: var(--space-5);
  }
  .pf__stack {
    margin-top: var(--space-3);
    font-size: var(--fs-micro);
    color: var(--ink-3);
    line-height: 1.6;
  }
  .pf__stack-k {
    color: var(--tone-ink, var(--ink-2));
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-right: 0.4rem;
  }
  .pf--dark .pf__stack-k {
    color: var(--ink-2);
  }
  .pf__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
  }
  .pf__private {
    color: var(--ink-3);
    width: 100%;
  }

  /* interaction: one coordinated response on hover or keyboard focus */
  .pf:hover .pf__index,
  .pf:focus-within .pf__index {
    transform: translateX(6px);
  }
  .pf:hover .pf__title a,
  .pf:focus-within .pf__title a {
    text-decoration-color: currentColor;
  }
  @media (pointer: fine) {
    .pf:hover .pf__visual-link {
      transform: perspective(var(--perspective)) rotateY(calc(var(--tilt-max) * 1)) translateY(var(--lift));
    }
    .pf--flip:hover .pf__visual-link {
      transform: perspective(var(--perspective)) rotateY(calc(var(--tilt-max) * -1)) translateY(var(--lift));
    }
  }

  /* flagship: the largest card, a badge and the capability row */
  .pf__flag {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--c-gold);
    color: var(--c-hickory);
    font-size: var(--fs-micro);
    font-weight: 500;
  }
  .pf--flagship {
    padding-block: clamp(4rem, 7vw, 7rem);
  }
  .pf--flagship .pf__grid {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  .pf--flagship .pf__title {
    font-size: clamp(2.3rem, 1.5rem + 2.5vw, 3.8rem);
  }
  .pf__extra {
    margin-top: var(--space-6);
  }
  .pf__demo {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule-strong);
  }
  .pf__demo-k {
    color: var(--c-gold);
    font-weight: 500;
  }
  .pf__demo-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-5);
    font-size: var(--fs-small);
    color: var(--ink);
  }
  .pf__demo-list li {
    display: flex;
    gap: 0.5rem;
  }
  .pf__demo-list .mono {
    color: var(--warm-ink);
  }

  /* secondary project: same anatomy, quieter scale */
  .pf--secondary {
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }
  .pf--secondary .pf__grid {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  .pf--secondary .pf__title {
    font-size: clamp(1.7rem, 1.25rem + 1.4vw, 2.5rem);
  }

  @media (max-width: 64rem) {
    .pf__grid,
    .pf--secondary .pf__grid,
    .pf--flagship .pf__grid {
      grid-template-columns: 1fr;
    }
    .pf__demo-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pf--flip .pf__visual {
      order: 0;
    }
    .pf__visual {
      max-width: 44rem;
    }
  }
  @media (max-width: 40rem) {
    .pf__head {
      gap: var(--space-2) var(--space-4);
    }
    .pf__year {
      margin-left: 0;
    }
    .pf__facts div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .pf__metrics {
      grid-template-columns: 1fr;
    }
    .pf__actions .btn {
      width: 100%;
    }
  }
</style>
