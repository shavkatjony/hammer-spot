---
import SectionHead from './SectionHead.astro';
import ExtLink from './ExtLink.astro';
import { toolkit, projects } from '../content/site';
import { url } from '../lib/url';

const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));
---
<section class="section toolkit" id="toolkit" aria-labelledby="toolkit-title">
  <div class="wrap wrap--wide">
    <SectionHead no="03" title="Toolkit" id="toolkit-title">
      No skill bars and no logo wall. Tools in the first group are demonstrated in finished work and link to the case
      study that shows them; the others are labelled for what they are.
    </SectionHead>

    <div class="tk">
      <div class="tk__col tk__col--use">
        <h3 class="tk__head"><span class="tk__no mono">A</span> Demonstrated in projects</h3>
        <ul role="list" class="tk__list">
          {toolkit.demonstrated.map((t) => (
            <li class="tk__item" data-reveal="fade">
              <ExtLink href={t.href} class="tk__name">{t.name}</ExtLink>
              <p class="tk__why">{t.why}</p>
              {(t.evidence.length > 0 || t.repo) && (
                <p class="tk__ev">
                  <span class="tk__ev-label mono">Shown in</span>
                  {t.evidence.map((s) => (
                    <a href={url(`work/${s}/`)} class="tk__chip">
                      <span class="mono">{bySlug[s]?.index}</span> {bySlug[s]?.short}
                    </a>
                  ))}
                  {t.repo && (
                    <ExtLink href={t.repo.href} class="tk__chip tk__chip--repo">{t.repo.label}</ExtLink>
                  )}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>

      <div class="tk__side">
        <div class="tk__col">
          <h3 class="tk__head"><span class="tk__no mono">B</span> Learning now</h3>
          <ul role="list" class="tk__list tk__list--single">
            {toolkit.learning.map((t) => (
              <li class="tk__item" data-reveal="fade">
                <ExtLink href={t.href} class="tk__name">{t.name}</ExtLink>
                <p class="tk__why">{t.why}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="tk__col">
          <h3 class="tk__head"><span class="tk__no mono">C</span> Open source studied</h3>
          <ul role="list" class="tk__list tk__list--single">
            {toolkit.studied.map((t) => (
              <li class="tk__item" data-reveal="fade">
                <ExtLink href={t.href} class="tk__name">{t.name}</ExtLink>
                <p class="tk__why">{t.why}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tk {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-7) var(--space-6);
  }
  .tk__col--use {
    grid-column: 1 / span 8;
  }
  .tk__side {
    grid-column: 9 / span 4;
    display: grid;
    gap: var(--space-7);
    align-content: start;
  }
  .tk__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--fs-h3);
    padding-bottom: var(--space-3);
    border-bottom: 1.5px solid var(--ink);
    margin-bottom: var(--space-1);
  }
  .tk__no {
    color: var(--warm-ink);
    font-size: var(--fs-micro);
    font-weight: 500;
  }
  .tk__col--use .tk__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-6);
  }
  .tk__item {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--rule);
  }
  .tk__item :global(.tk__name) {
    font-weight: 600;
    text-decoration-color: var(--rule-strong);
  }
  .tk__why {
    margin-top: var(--space-1);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .tk__ev {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-3);
  }
  .tk__ev-label {
    color: var(--ink-3);
    margin-right: 0.2rem;
  }
  .tk__ev :global(.tk__chip),
  .tk__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 28px;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: background-color var(--dur-1) ease, color var(--dur-1) ease, border-color var(--dur-1) ease;
  }
  .tk__chip .mono {
    color: var(--warm-ink);
  }
  .tk__ev :global(.tk__chip:hover),
  .tk__chip:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .tk__chip:hover .mono {
    color: inherit;
  }
  .tk__ev :global(.tk__chip--repo) {
    border-style: dashed;
  }
  @media (max-width: 72rem) {
    .tk__col--use,
    .tk__side {
      grid-column: 1 / -1;
    }
    .tk__side {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }
  @media (max-width: 52rem) {
    .tk__col--use .tk__list,
    .tk__side {
      grid-template-columns: 1fr;
    }
  }
</style>
