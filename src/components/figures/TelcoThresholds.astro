---
/**
 * Precision and recall across decision thresholds, from the EXPLORATORY notebook model
 * (logistic regression without class weighting, notebooks/04_evaluation.ipynb).
 * Source: telco-c-classifier-alias/reports/threshold_analysis.csv (held-out test set).
 * NOTE: the shipped pipeline (src/train.py) uses class_weight="balanced", so these curves
 * do not describe it. The caption says so; the case study lists regenerating it as a next step.
 * Two series on ONE axis (both 0–1): legend + direct end labels; palette validated.
 */
const data = [
  [0.2, 0.4686, 0.8583],
  [0.25, 0.4951, 0.8182],
  [0.3, 0.5193, 0.7567],
  [0.35, 0.5412, 0.7032],
  [0.4, 0.5653, 0.6711],
  [0.45, 0.6016, 0.6176],
  [0.5, 0.6552, 0.5588],
  [0.55, 0.6758, 0.4626],
  [0.6, 0.7233, 0.3984],
  [0.65, 0.7483, 0.3021],
  [0.7, 0.7419, 0.1845],
  [0.75, 0.7436, 0.0775],
  [0.8, 0.75, 0.0241],
] as const;
const X0 = 0.2, X1 = 0.8;
const vx = (t: number) => ((t - X0) / (X1 - X0)) * 100;
const vy = (v: number) => 100 - v * 100;
const line = (k: 1 | 2) => data.map((d, i) => `${i ? 'L' : 'M'}${vx(d[0]).toFixed(2)} ${vy(d[k]).toFixed(2)}`).join(' ');
const pc = (n: number) => `${n.toFixed(2)}%`;
const refs = [{ t: 0.5, label: 'default threshold 0.50' }];
const last = data[data.length - 1];
const json = JSON.stringify(data);
---
<figure class="tchart" data-tchart data-points={json}>
  <div class="tchart__legend" aria-hidden="true">
    <span class="tchart__key tchart__key--recall">Recall (churners caught)</span>
    <span class="tchart__key tchart__key--precision">Precision (alerts that were real)</span>
  </div>
  <div class="tchart__frame">
    <div class="tchart__plot" tabindex="0" role="img" aria-label="Line chart for the earlier, unweighted notebook model: as the decision threshold rises from 0.20 to 0.80, recall falls from 0.86 to 0.02 while precision rises from 0.47 to 0.75. Full values in the data table below.">
      <svg class="tchart__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {[0, 0.25, 0.5, 0.75, 1].map((v) => <line class="tchart__grid" x1="0" x2="100" y1={vy(v)} y2={vy(v)} />)}
        <path class="tchart__line tchart__line--recall" d={line(2)} />
        <path class="tchart__line tchart__line--precision" d={line(1)} />
      </svg>
      <svg class="tchart__overlay" aria-hidden="true">
        {refs.map((r) => (
          <g>
            <line class="tchart__ref" x1={pc(vx(r.t))} x2={pc(vx(r.t))} y1="0" y2="100%" />
          </g>
        ))}
        {[0, 0.25, 0.5, 0.75, 1].map((v) => (
          <text class="tchart__tick" x="-10" y={pc(vy(v))} dy="4" text-anchor="end">{v.toFixed(2)}</text>
        ))}
        {[0.2, 0.35, 0.5, 0.65, 0.8].map((t) => (
          <text class="tchart__tick" x={pc(vx(t))} y="100%" dy="20" text-anchor="middle">{t.toFixed(2)}</text>
        ))}
        <circle class="tchart__end tchart__end--recall" cx="100%" cy={pc(vy(last[2]))} r="4.5" />
        <circle class="tchart__end tchart__end--precision" cx="100%" cy={pc(vy(last[1]))} r="4.5" />
        <text class="tchart__endlabel" x="100%" dx="12" y={pc(vy(last[1]))} dy="4">Precision {last[1].toFixed(2)}</text>
        <text class="tchart__endlabel" x="100%" dx="12" y={pc(vy(last[2]))} dy="4">Recall {last[2].toFixed(2)}</text>
        <g class="tchart__cross" data-cross>
          <line class="tchart__crossline" x1="0" x2="0" y1="0" y2="100%" data-cross-line />
          <circle class="tchart__end tchart__end--recall" r="4.5" cx="0" cy="0" data-cross-r />
          <circle class="tchart__end tchart__end--precision" r="4.5" cx="0" cy="0" data-cross-p />
        </g>
      </svg>
      <div class="tchart__tip" data-tip role="status" aria-live="polite"></div>
    </div>
    <ul class="tchart__refs" role="list">
      {refs.map((r) => <li class="mono">{r.label}</li>)}
    </ul>
    <p class="tchart__xlabel mono">Decision threshold →</p>
  </div>
  <details class="tchart__table no-print">
    <summary class="mono">View data table</summary>
    <table>
      <thead><tr><th scope="col">Threshold</th><th scope="col">Precision</th><th scope="col">Recall</th></tr></thead>
      <tbody>
        {data.map((d) => (
          <tr><th scope="row">{d[0].toFixed(2)}</th><td>{d[1].toFixed(3)}</td><td>{d[2].toFixed(3)}</td></tr>
        ))}
      </tbody>
    </table>
  </details>
  <figcaption class="tchart__cap">
    <span class="mono">Fig.</span> Threshold sweep on the held-out test set for the <strong>earlier notebook model</strong>
    (logistic regression without class weighting). The shipped pipeline is class-weighted, so its curves differ;
    regenerating this sweep for it is the next step. Hover, or focus the chart and use ← →, to read values. Source:
    <code>reports/threshold_analysis.csv</code>.
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-tchart]').forEach((fig) => {
    const pts = JSON.parse(fig.dataset.points || '[]') as [number, number, number][];
    const plot = fig.querySelector<HTMLElement>('.tchart__plot');
    const cross = fig.querySelector<SVGGElement>('[data-cross]');
    const line = fig.querySelector<SVGLineElement>('[data-cross-line]');
    const cr = fig.querySelector<SVGCircleElement>('[data-cross-r]');
    const cp = fig.querySelector<SVGCircleElement>('[data-cross-p]');
    const tip = fig.querySelector<HTMLElement>('[data-tip]');
    if (!plot || !cross || !line || !cr || !cp || !tip || !pts.length) return;
    let idx = 6;
    const show = (i: number) => {
      idx = Math.max(0, Math.min(pts.length - 1, i));
      const [t, p, r] = pts[idx];
      const x = ((t - 0.2) / 0.6) * 100;
      line.setAttribute('x1', `${x}%`);
      line.setAttribute('x2', `${x}%`);
      cr.setAttribute('cx', `${x}%`);
      cr.setAttribute('cy', `${(1 - r) * 100}%`);
      cp.setAttribute('cx', `${x}%`);
      cp.setAttribute('cy', `${(1 - p) * 100}%`);
      cross.classList.add('is-on');
      tip.textContent = `Threshold ${t.toFixed(2)} · recall ${r.toFixed(3)} · precision ${p.toFixed(3)}`;
      tip.classList.add('is-on');
      const w = plot.clientWidth;
      const left = Math.min(Math.max((x / 100) * w, 90), w - 90);
      tip.style.transform = `translateX(${left.toFixed(0)}px) translateX(-50%)`;
    };
    const hide = () => {
      cross.classList.remove('is-on');
      tip.classList.remove('is-on');
    };
    plot.addEventListener('pointermove', (e) => {
      const r = plot.getBoundingClientRect();
      const t = 0.2 + ((e.clientX - r.left) / r.width) * 0.6;
      show(Math.round((t - 0.2) / 0.05));
    });
    plot.addEventListener('pointerleave', hide);
    plot.addEventListener('focus', () => show(idx));
    plot.addEventListener('blur', hide);
    plot.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { show(idx + 1); e.preventDefault(); }
      if (e.key === 'ArrowLeft') { show(idx - 1); e.preventDefault(); }
    });
  });
</script>

<style>
  .tchart__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--fs-small);
    color: var(--ink-2);
    margin-bottom: var(--space-4);
  }
  .tchart__key {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tchart__key::before {
    content: '';
    width: 1.25rem;
    height: 2px;
    border-radius: 2px;
  }
  .tchart__key--recall::before { background: var(--series-1); }
  .tchart__key--precision::before { background: var(--series-2); }
  .tchart__frame {
    position: relative;
    padding: 0.5rem 7.5rem 2.6rem 2.75rem;
  }
  .tchart__plot {
    position: relative;
    height: clamp(13rem, 30vw, 18rem);
    cursor: crosshair;
    touch-action: pan-y;
  }
  .tchart__lines,
  .tchart__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .tchart__grid {
    stroke: var(--chart-grid);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .tchart__line {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .tchart__line--recall { stroke: var(--series-1); }
  .tchart__line--precision { stroke: var(--series-2); }
  .tchart__ref {
    stroke: var(--ink-3);
    stroke-width: 1;
    opacity: 0.55;
  }
  .tchart__tick {
    fill: var(--ink-3);
    font-family: var(--f-mono);
    font-size: 11px;
  }
  .tchart__endlabel {
    fill: var(--ink);
    font-family: var(--f-mono);
    font-size: 12px;
  }
  .tchart__end {
    stroke: var(--surface);
    stroke-width: 2;
  }
  .tchart__end--recall { fill: var(--series-1); }
  .tchart__end--precision { fill: var(--series-2); }
  .tchart__cross {
    opacity: 0;
    transition: opacity var(--dur-1) ease;
  }
  :global(.tchart__cross.is-on) {
    opacity: 1;
  }
  .tchart__crossline {
    stroke: var(--ink);
    stroke-width: 1;
  }
  .tchart__tip {
    position: absolute;
    left: 0;
    top: -2.2rem;
    padding: 0.3rem 0.6rem;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--f-mono);
    font-size: var(--fs-micro);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-1) ease;
  }
  :global(.tchart__tip.is-on) {
    opacity: 1;
  }
  .tchart__refs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-top: 2.4rem;
    color: var(--ink-3);
  }
  .tchart__refs li::before {
    content: '│ ';
    color: var(--ink-3);
  }
  .tchart__xlabel {
    position: absolute;
    right: 7.5rem;
    bottom: 3.2rem;
    color: var(--ink-3);
    display: none;
  }
  .tchart__table {
    margin-top: var(--space-4);
    font-size: var(--fs-small);
  }
  .tchart__table summary {
    cursor: pointer;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--ink-2);
  }
  .tchart__table th,
  .tchart__table td {
    text-align: left;
    padding: 0.3rem 1.2rem 0.3rem 0;
    border-bottom: 1px solid var(--rule-soft);
    font-weight: 400;
    font-family: var(--f-mono);
    font-variant-numeric: tabular-nums;
  }
  .tchart__cap {
    margin-top: var(--space-4);
    font-size: var(--fs-small);
    color: var(--ink-3);
    max-width: 62ch;
  }
  @media (max-width: 30rem) {
    .tchart__frame {
      padding-right: 6.4rem;
    }
    .tchart__endlabel {
      font-size: 11px;
    }
  }
</style>
