---
// Newsreader: optical-size variable roman for headlines (preloaded), weight-only italic for the statement.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
// Pretendard (OFL): Korean glyphs. Split by unicode range, so a browser only downloads the pieces a page uses.
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SunRail from '../components/SunRail.astro';
import { getContent, social, email } from '../content';
import { ui } from '../content/ui';
import { getLang, altHref, htmlLang, ogLocale, LANGS } from '../lib/i18n';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  rail?: boolean;
  navOnDark?: boolean; // the page opens on a dark header: invert the nav until it turns solid
  alternates?: boolean; // false on the 404 page
}
const lang = getLang(Astro.url);
const t = ui[lang];
const { identity, meta, education } = getContent(lang);
const {
  title = meta.title,
  description = meta.description,
  ogType = 'website',
  rail = false,
  navOnDark = false,
  alternates = true,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('og.jpg'), Astro.site).href;
const alt = LANGS.map((l) => ({ l, href: new URL(altHref(Astro.url, l), Astro.site).href }));

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.name,
  alternateName: identity.nameLocal ? [identity.handle, identity.nameLocal] : identity.handle,
  jobTitle: identity.title,
  address: { '@type': 'PostalAddress', addressLocality: identity.location.city, addressCountry: 'KR' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: education[0].school },
  email: `mailto:${email}`,
  url: new URL(url(), Astro.site).href,
  sameAs: [social.github.href, social.linkedin.href],
  description: identity.positioning,
  knowsAbout: t.knowsAbout,
};
---
<!doctype html>
<html lang={htmlLang[lang]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && alt.map((a) => <link rel="alternate" hreflang={htmlLang[a.l]} href={a.href} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={alt[0].href} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#eee6d9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d1822" media="(prefers-color-scheme: dark)" />
    <meta name="author" content={identity.name} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap.xml')} />
    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt(identity.name, identity.title)} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Theme + motion bootstrap: runs before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var d = document.documentElement, t = null, s = null;
        d.classList.add('js');
        try { t = localStorage.getItem('theme'); s = sessionStorage.getItem('intro-seen'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.setAttribute('data-theme', t);
        if (s) d.classList.add('intro-seen');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion');
          // Safety net: if the motion module never initialises, show everything.
          setTimeout(function () { if (!d.classList.contains('reveal-ready')) d.classList.remove('motion'); }, 3500);
        }
      })();
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Nav onDark={navOnDark} />
    {rail && <SunRail />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
