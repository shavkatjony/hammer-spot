---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Not found · SHAVKATJON" description="This page could not be found.">
  <section class="nf wrap">
    <p class="mono muted">Error 404 · coordinates unknown</p>
    <h1 class="nf__title">Nothing here but sand.</h1>
    <p class="lead">The page you were looking for has drifted. Try the selected work, or start from the top.</p>
    <p class="nf__links">
      <a class="link-arrow" href={url('#work')}>Selected work →</a>
      <a class="link-arrow" href={url()}>Home →</a>
    </p>
  </section>
</Base>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    align-content: center;
    gap: var(--space-4);
    padding-top: var(--nav-h);
  }
  .nf__title {
    font-size: var(--fs-h1);
    line-height: 0.95;
  }
  .nf__links {
    display: flex;
    gap: var(--space-5);
  }
</style>
