---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ExtLink from '../components/ExtLink.astro';
import { identity, social, email, education, experience, languages, projects, resume } from '../content/site';
import { url } from '../lib/url';
const site = new URL(url(), Astro.site).href.replace(/^https?:\/\//, '').replace(/\/$/, '');
const skills = [
  { k: 'Languages', v: 'Python, SQL (SQLite, DuckDB)' },
  { k: 'Data & ML', v: 'pandas, NumPy, scikit-learn (pipelines, stratified CV), statsmodels (OLS, logit)' },
  { k: 'Data engineering', v: 'Parquet/PyArrow, DuckDB star schemas, data-quality gates, idempotent ingestion' },
  { k: 'Practice', v: 'pytest, ruff, uv, GitHub Actions CI, Makefiles, decision records' },
  { k: 'Delivery', v: 'Streamlit, matplotlib, self-contained HTML dashboards' },
  { k: 'Learning', v: 'Tableau, FastAPI, dbt, MLflow, R (coursework)' },
];
---
<Base title="Résumé · Shavkatjon Yuldashev" description="Résumé of Shavkatjon Yuldashev, early-career data scientist in Busan, South Korea.">
  <div class="cv-tools wrap no-print">
    <a class="link-arrow" href={url()}><Icon name="arrow-left" /> Back to site</a>
    <div class="cv-tools__right">
      <button class="action" type="button" data-print>Print or save as PDF</button>
      {resume.pdf && (
        <a class="action" href={url(resume.pdf)} download><Icon name="download" /> Download PDF</a>
      )}
    </div>
  </div>

  <article class="cv wrap" aria-labelledby="cv-name">
    <header class="cv__head">
      <h1 id="cv-name" class="cv__name">{identity.name}</h1>
      <p class="cv__role">Data Science · Machine Learning · Applied AI · early career</p>
      <p class="cv__contact">
        <span>{identity.location.city}, {identity.location.country}</span>
        <ExtLink href={social.email.href}>{email}</ExtLink>
        <ExtLink href={social.github.href}>github.com/{social.github.handle}</ExtLink>
        <ExtLink href={social.linkedin.href}>LinkedIn</ExtLink>
        <a href={url()}>{site}</a>
      </p>
    </header>

    <section class="cv__sec" aria-labelledby="cv-sum">
      <h2 id="cv-sum" class="cv__h">Summary</h2>
      <p>
        Early-career data scientist with a business-statistics background. I build projects end to end, from raw data
        and SQL through evaluated models to something a person can use, and I report results against baselines, with
        their limits stated. Open to junior, internship and research roles in Korea and with international,
        English-speaking teams.
      </p>
    </section>

    <section class="cv__sec" aria-labelledby="cv-proj">
      <h2 id="cv-proj" class="cv__h">Selected projects</h2>
      {projects.map((p) => (
        <div class="cv__item">
          <p class="cv__item-head">
            <strong>{p.title}</strong>
            <span class="cv__meta">{p.kicker} · {p.year} · {p.status}</span>
          </p>
          <ul>
            <li>{p.contribution}</li>
            <li>{p.result}</li>
          </ul>
          <p class="cv__stack">{p.stack.join(' · ')} · <a href={p.links[0].href}>{p.links[0].href.replace('https://', '')}</a></p>
        </div>
      ))}
    </section>

    <section class="cv__sec" aria-labelledby="cv-exp">
      <h2 id="cv-exp" class="cv__h">Experience</h2>
      {experience.map((x) => (
        <div class="cv__item">
          <p class="cv__item-head"><strong>{x.role}, {x.org}</strong><span class="cv__meta">{x.period} · {x.place}</span></p>
          <ul>{x.points.map((pt) => <li>{pt}</li>)}</ul>
        </div>
      ))}
    </section>

    <section class="cv__sec" aria-labelledby="cv-edu">
      <h2 id="cv-edu" class="cv__h">Education</h2>
      {education.map((e) => (
        <div class="cv__item">
          <p class="cv__item-head"><strong>{e.degree}</strong><span class="cv__meta">{e.school}, {e.place} · {e.year}</span></p>
          <p>Focus: {e.focus}.</p>
        </div>
      ))}
    </section>

    <section class="cv__sec cv__two" aria-labelledby="cv-skills">
      <h2 id="cv-skills" class="cv__h">Skills</h2>
      <dl class="cv__skills">
        {skills.map((s) => (<div><dt>{s.k}</dt><dd>{s.v}</dd></div>))}
        <div><dt>Spoken</dt><dd>{languages.map((l) => `${l.name} (${l.level})`).join(', ')}</dd></div>
      </dl>
    </section>
  </article>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .cv-tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding-top: calc(var(--nav-h) + var(--space-5));
    max-width: calc(52rem + 2 * var(--gutter));
  }
  .cv-tools__right {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cv {
    max-width: calc(52rem + 2 * var(--gutter));
    padding-block: var(--space-6) var(--space-9);
    font-size: 0.97rem;
    line-height: 1.5;
  }
  .cv__head {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--ink);
  }
  .cv__name {
    font-size: clamp(2.4rem, 1.6rem + 3vw, 3.6rem);
    line-height: 1;
  }
  .cv__role {
    margin-top: var(--space-2);
    font-family: var(--f-mono);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .cv__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.2rem;
    margin-top: var(--space-3);
    font-size: var(--fs-small);
  }
  .cv__sec {
    padding-top: var(--space-5);
  }
  .cv__h {
    font-family: var(--f-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--rule);
  }
  .cv__item + .cv__item {
    margin-top: var(--space-4);
  }
  .cv__item-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.1rem 1rem;
  }
  .cv__item-head strong {
    font-weight: 500;
  }
  .cv__meta {
    color: var(--ink-3);
    font-size: var(--fs-small);
  }
  .cv__item ul {
    margin-top: var(--space-1);
    padding-left: 1.1em;
    color: var(--ink-2);
  }
  .cv__stack {
    margin-top: var(--space-1);
    font-family: var(--f-mono);
    font-size: var(--fs-micro);
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .cv__skills {
    display: grid;
    gap: var(--space-2);
  }
  .cv__skills div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-3);
  }
  .cv__skills dt {
    color: var(--ink-3);
    font-size: var(--fs-small);
  }
  @media (max-width: 30rem) {
    .cv__skills div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  @media print {
    @page {
      size: A4;
      margin: 11mm 13mm;
    }
    .cv {
      padding: 0;
      max-width: none;
      font-size: 8.7pt;
      line-height: 1.38;
      color: #000;
    }
    .cv__name {
      font-size: 21pt;
    }
    .cv__head {
      padding-bottom: 5pt;
    }
    .cv__contact {
      margin-top: 3pt;
    }
    .cv__sec {
      padding-top: 7pt;
    }
    .cv__h {
      margin-bottom: 4pt;
    }
    .cv__item {
      break-inside: avoid;
    }
    .cv__item + .cv__item {
      margin-top: 4.5pt;
    }
    .cv__item ul {
      margin-top: 1pt;
    }
    .cv__skills {
      gap: 1.5pt;
    }
    .cv a {
      color: #000;
      text-decoration: none;
    }
    .cv__meta,
    .cv__h,
    .cv__stack,
    .cv__skills dt {
      color: #444;
    }
    :global(.footer),
    :global(.visually-hidden) {
      display: none !important;
    }
  }
</style>
