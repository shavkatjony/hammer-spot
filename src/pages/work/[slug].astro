---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/figures/Figure.astro';
import Rich from '../../components/Rich.astro';
import ExtLink from '../../components/ExtLink.astro';
import Icon from '../../components/Icon.astro';
import { projects, type Project } from '../../content/site';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      project: p,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}
interface Props {
  project: Project;
  prev: Project;
  next: Project;
}
const { project: p, prev, next } = Astro.props;
const dark = p.tone === 'coffee' || p.tone === 'yale';
const toneClass = p.tone === 'coffee' ? 'band-coffee' : p.tone === 'yale' ? 'band-yale' : `tone-${p.tone}`;
const icon = (k: string) => (k === 'demo' ? 'play' : k === 'repo' ? 'github' : k === 'data' ? 'data' : 'doc') as
  | 'play'
  | 'github'
  | 'data'
  | 'doc';
---
<Base
  title={`${p.title} · Case study · Shavkatjon Yuldashev`}
  description={`${p.caseStudy.summary} ${p.result}`}
  ogType="article"
  navOnDark={dark}
>
  <article class="cs" aria-labelledby="cs-title">
    <header class:list={['cs__head', toneClass, { 'cs__head--dark': dark }]}>
      {dark && <div class="cs__topo" aria-hidden="true"></div>}
      <div class="wrap wrap--wide cs__head-inner">
        <nav class="cs__switch" aria-label="All case studies">
          <a class="link-arrow cs__back" href={url('#work')}><Icon name="arrow-left" /> All work</a>
          <ol role="list" class="cs__switch-list">
            {projects.map((x) => (
              <li>
                <a href={url(`work/${x.slug}/`)} aria-current={x.slug === p.slug ? 'page' : undefined}>
                  <span class="mono">{x.index}</span> {x.short}
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <p class="cs__crumbs mono caps">
          <span>Case study {p.index}</span>{' '}<span>{p.kicker}</span>{' '}<span>{p.year}</span>
        </p>
        <h1 id="cs-title" class={`cs__title vt-${p.slug}`}>{p.title}</h1>
        <p class="cs__summary">{p.caseStudy.summary}</p>
        <div class="cs__status">
          <span class="status" data-status={p.status}>{p.status}</span>{' '}
          {p.statusNote && <span class="muted">{p.statusNote}</span>}
        </div>
        <ul class="cs__metrics" role="list">
          {p.metrics.map((m) => (
            <li><span class="cs__metric-v">{m.value}</span>{' '}<span class="cs__metric-l">{m.label}</span></li>
          ))}
        </ul>
        <div class="cs__head-actions">
          {p.links
            .filter((l) => l.kind === 'repo' || l.kind === 'demo')
            .map((l) => (
              <ExtLink href={l.href} class={l.kind === 'repo' ? 'btn btn--primary' : 'btn btn--ghost'}>
                <Icon name={icon(l.kind)} /> {l.label}
              </ExtLink>
            ))}
          {!p.repoPublic && p.privateNote && (
            <p class="cs__private mono"><Icon name="lock" /> {p.privateNote}</p>
          )}
        </div>
      </div>
    </header>

    <div class="wrap wrap--wide cs__body">
      <aside class="cs__aside" aria-label="Project details">
        <div class="cs__aside-inner">
          <nav aria-label="On this page" class="cs__toc">
            <p class="mono caps muted">Contents</p>
            <ol role="list">
              {p.caseStudy.sections.map((s, i) => (
                <li><a href={`#${s.id}`}><span class="mono">{i + 1}</span> {s.title}</a></li>
              ))}
              <li><a href="#evidence"><span class="mono">{p.caseStudy.sections.length + 1}</span> Repository and demo</a></li>
            </ol>
          </nav>
          <div class="cs__stack">
            <p class="mono caps muted">Stack</p>
            <ul class="tags" role="list">
              {p.stack.map((t) => <li class="tag">{t}</li>)}
            </ul>
            <p class="mono caps muted cs__stack-h">Methods</p>
            <p>{p.methods.join(' · ')}</p>
          </div>
        </div>
      </aside>

      <div class="cs__content">
        {p.caseStudy.sections.map((s, i) => (
          <section class="cs__section" id={s.id} aria-labelledby={`${s.id}-h`}>
            <p class="cs__no mono">{String(i + 1).padStart(2, '0')}</p>
            <h2 id={`${s.id}-h`} class="cs__h" data-reveal="mask">{s.title}</h2>
            <div class="prose cs__prose">
              {s.body.map((para) => <p><Rich text={para} /></p>)}
              {s.list && (
                <ul>
                  {s.list.map((li) => <li><Rich text={li} /></li>)}
                </ul>
              )}
            </div>
            {s.figures?.map((f) => (
              <div class="cs__figure">
                <Figure id={f} />
              </div>
            ))}
          </section>
        ))}

        <section class="cs__section cs__evidence" id="evidence" aria-labelledby="evidence-h">
          <p class="cs__no mono">{String(p.caseStudy.sections.length + 1).padStart(2, '0')}</p>
          <h2 id="evidence-h" class="cs__h">Repository and demo</h2>
          {p.links.length > 0 ? (
            <ul role="list" class="cs__links">
              {p.links.map((l) => (
                <li>
                  <ExtLink href={l.href} class="cs__link">
                    <Icon name={icon(l.kind)} />
                    <span class="cs__link-label">{l.label}</span>
                    <span class="cs__link-url mono">{l.href.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>
                  </ExtLink>
                </li>
              ))}
            </ul>
          ) : (
            <p class="cs__private-block"><Icon name="lock" /> {p.privateNote}</p>
          )}
        </section>
      </div>
    </div>

    <nav class="cs__pager wrap wrap--wide" aria-label="More case studies">
      <a href={url(`work/${prev.slug}/`)} class="cs__pager-link cs__pager-link--prev">
        <span class="mono muted">← Previous</span>
        <span class="cs__pager-title"><span class="mono">{prev.index}</span> {prev.title}</span>
      </a>
      <a href={url(`work/${next.slug}/`)} class="cs__pager-link cs__pager-link--next">
        <span class="mono muted">Next →</span>
        <span class="cs__pager-title"><span class="mono">{next.index}</span> {next.title}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .cs__head {
    position: relative;
    padding: calc(var(--nav-h) + var(--space-5)) 0 var(--space-8);
    background: var(--tone-bg, var(--surface-2));
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }
  .cs__head--dark {
    background: var(--bg);
    color: var(--ink);
    border-bottom: 0;
  }
  .cs__topo {
    position: absolute;
    inset: 0;
    background: var(--rule-strong);
    -webkit-mask: url('../../assets/textures/topo.svg') center / cover no-repeat;
    mask: url('../../assets/textures/topo.svg') center / cover no-repeat;
    opacity: 0.16; /* decorative: kept faint so text over a line keeps its contrast */
  }
  .cs__head-inner {
    position: relative;
  }
  .cs__switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--rule-strong);
  }
  .cs__switch-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
  }
  .cs__switch-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 34px;
    padding: 0.2rem 0.65rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: var(--fs-small);
    text-decoration: none;
    color: var(--ink-2);
  }
  .cs__switch-list a .mono {
    color: var(--tone-ink, var(--accent));
  }
  .cs__head--dark .cs__switch-list a .mono {
    color: var(--warm-ink);
  }
  .cs__switch-list a:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
  }
  .cs__switch-list a[aria-current='page'] {
    border-color: var(--ink);
    color: var(--ink);
    font-weight: 500;
  }
  .cs__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    color: var(--tone-ink, var(--ink-2));
    font-weight: 500;
    margin-bottom: var(--space-4);
  }
  .cs__head--dark .cs__crumbs {
    color: var(--ink-2);
  }
  .cs__title {
    font-size: var(--fs-h1);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 18ch;
  }
  .cs__summary {
    margin-top: var(--space-5);
    font-family: var(--f-display);
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.65rem);
    line-height: 1.32;
    max-width: 48ch;
    color: var(--ink-2);
  }
  .cs__status {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-5);
    font-size: var(--fs-small);
  }
  .cs__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 15rem));
    gap: var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule-strong);
  }
  .cs__metrics li {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }
  .cs__metric-v {
    font-family: var(--f-display);
    font-size: clamp(1.8rem, 1.3rem + 1.4vw, 2.7rem);
    font-weight: 500;
    line-height: 1;
  }
  .cs__metric-l {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .cs__head-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .cs__head-actions :global(.btn--ghost) {
    background: color-mix(in oklab, var(--tone-bg, var(--bg)) 70%, transparent);
  }
  .cs__private,
  .cs__private-block {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-2);
  }
  .cs__private :global(svg),
  .cs__private-block :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .cs__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-6);
    padding-block: var(--space-8);
  }
  .cs__aside {
    grid-column: 1 / span 3;
  }
  .cs__aside-inner {
    position: sticky;
    top: calc(var(--nav-h) + var(--space-5));
    display: grid;
    gap: var(--space-6);
    font-size: var(--fs-small);
  }
  .cs__toc ol {
    margin-top: var(--space-2);
  }
  .cs__toc a {
    display: flex;
    gap: var(--space-3);
    padding: 0.45rem 0;
    text-decoration: none;
    color: var(--ink-2);
    border-bottom: 1px solid var(--rule);
  }
  .cs__toc a:hover {
    color: var(--accent);
  }
  .cs__toc .mono {
    color: var(--warm-ink);
    min-width: 1rem;
  }
  .cs__stack .tags {
    margin-top: var(--space-2);
  }
  .cs__stack p:not(.mono) {
    color: var(--ink-2);
    margin-top: var(--space-1);
  }
  .cs__stack-h {
    margin-top: var(--space-4);
  }
  .cs__content {
    grid-column: 5 / span 8;
    display: grid;
    gap: var(--space-8);
  }
  .cs__section {
    scroll-margin-top: calc(var(--nav-h) + var(--space-4));
  }
  .cs__no {
    color: var(--warm-ink);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }
  .cs__h {
    font-size: clamp(1.85rem, 1.3rem + 1.7vw, 2.85rem);
    margin-bottom: var(--space-4);
  }
  .cs__prose {
    color: var(--ink-2);
  }
  .cs__figure {
    margin-top: var(--space-6);
  }
  .cs__links {
    display: grid;
    gap: var(--space-2);
  }
  .cs__links :global(.cs__link) {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'icon label' 'icon url';
    align-items: center;
    gap: 0 var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    text-decoration: none;
    background: var(--surface);
    transition: border-color var(--dur-1) ease, transform var(--dur-1) var(--ease-out);
  }
  .cs__links :global(.cs__link svg) {
    grid-area: icon;
    width: 1.2rem;
    height: 1.2rem;
  }
  .cs__links :global(.cs__link:hover) {
    border-color: var(--accent);
    transform: translateX(3px);
  }
  .cs__link-label {
    grid-area: label;
    font-weight: 600;
  }
  .cs__link-url {
    grid-area: url;
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .cs__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    padding-block: var(--space-7) var(--space-9);
    border-top: 1px solid var(--rule-strong);
  }
  .cs__pager-link {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    text-decoration: none;
  }
  .cs__pager-link--next {
    text-align: right;
  }
  .cs__pager-title {
    font-family: var(--f-display);
    font-size: var(--fs-h3);
    line-height: 1.1;
  }
  .cs__pager-title .mono {
    color: var(--warm-ink);
    font-size: var(--fs-micro);
    vertical-align: middle;
  }
  .cs__pager-link:hover .cs__pager-title {
    color: var(--accent);
  }
  @media (max-width: 52rem) {
    .cs__aside,
    .cs__content {
      grid-column: 1 / -1;
    }
    .cs__aside-inner {
      position: static;
    }
    .cs__metrics {
      grid-template-columns: 1fr 1fr;
    }
    .cs__pager {
      grid-template-columns: 1fr;
    }
    .cs__pager-link--next {
      text-align: left;
    }
  }
  @media (max-width: 30rem) {
    .cs__metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
